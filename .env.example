# DeepSeek配置
DEEPSEEK_API_KEY=请填写自己的API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OPC UA配置
OPCUA_SERVER_URL=opc.tcp://PLC_IP地址:4840
OPCUA_USERNAME=
OPCUA_PASSWORD=

# AI调用设置
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=1
MAX_HISTORY_MESSAGES=20

# OPC UA连接设置
OPCUA_TIMEOUT_SECONDS=5
OPCUA_SESSION_TIMEOUT_MS=30000

# 日志设置
LOG_LEVEL=INFO